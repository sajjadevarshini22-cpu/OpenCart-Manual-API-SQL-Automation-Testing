{
  "info": {
    "name": "OpenCart API Practice - 15 Test Cases",
    "description": "Practice Postman collection for OpenCart/e-commerce API validation. Use official OpenCart API credentials or an OpenCart REST API extension/demo.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API-001 Login/API Session",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Oc-Merchant-Id",
            "value": "{{merchantKey}}",
            "description": "Use for OpenCart REST API extension/demo if required"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}",
            "description": "Use if your OpenCart API setup requires Bearer token"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/rest/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "rest",
            "login"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Response status is successful\", function () {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
              "});",
              "pm.test(\"Response time is acceptable\", function () {",
              "    pm.expect(pm.response.responseTime).to.be.below(3000);",
              "});",
              "pm.test(\"Response is JSON when body exists\", function () {",
              "    if (pm.response.text()) {",
              "        pm.response.to.be.withBody;",
              "    }",
              "});"
            ]
          }
        }
      ]
    },
